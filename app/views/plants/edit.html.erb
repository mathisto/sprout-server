<div class="min-h-full">
  <div class="py-10">
    <header>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
          <h1 class="text-3xl font-bold leading-tight tracking-tight text-gray-900">Edit Plant</h1>
          <div>
            <%= link_to "Back to Plant", plant_path(@plant), class: "text-green-600 hover:text-green-900" %>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
        <div class="mt-8 bg-white shadow sm:rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <%= form_with(model: @plant, class: "space-y-6") do |form| %>
              <% if @plant.errors.any? %>
                <div class="rounded-md bg-red-50 p-4 mb-6">
                  <div class="flex">
                    <div class="flex-shrink-0">
                      <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <div class="ml-3">
                      <h3 class="text-sm font-medium text-red-800">There are <%= pluralize(@plant.errors.count, "error") %> with this plant:</h3>
                      <div class="mt-2 text-sm text-red-700">
                        <ul class="list-disc pl-5 space-y-1">
                          <% @plant.errors.full_messages.each do |message| %>
                            <li><%= message %></li>
                          <% end %>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <div>
                <%= form.label :slug, "Name", class: "block text-sm font-medium leading-6 text-gray-900" %>
                <div class="mt-2">
                  <%= form.text_field :slug, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6", placeholder: "my-favorite-plant" %>
                </div>
                <p class="mt-2 text-sm text-gray-500">This will be used as both the plant's name and unique identifier. Use lowercase letters, numbers, and hyphens only.</p>
              </div>

              <div>
                <%= form.label :species, class: "block text-sm font-medium leading-6 text-gray-900" %>
                <div class="mt-2">
                  <%= form.text_field :species, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6", placeholder: "Monstera Deliciosa" %>
                </div>
              </div>

              <div>
                <%= form.label :location, class: "block text-sm font-medium leading-6 text-gray-900" %>
                <div class="mt-2">
                  <%= form.text_field :location, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6", placeholder: "Living Room" %>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <%= form.label :preferred_moisture_min, "Minimum Moisture (%)", class: "block text-sm font-medium leading-6 text-gray-900" %>
                  <div class="mt-2">
                    <%= form.number_field :preferred_moisture_min, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6", min: 0, max: 100 %>
                  </div>
                </div>

                <div>
                  <%= form.label :preferred_moisture_max, "Maximum Moisture (%)", class: "block text-sm font-medium leading-6 text-gray-900" %>
                  <div class="mt-2">
                    <%= form.number_field :preferred_moisture_max, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-green-600 sm:text-sm sm:leading-6", min: 0, max: 100 %>
                  </div>
                </div>
              </div>
              <p class="text-sm text-gray-500">Set the preferred moisture range for your plant</p>

              <div class="pt-5">
                <div class="flex justify-end">
                  <%= link_to "Cancel", plant_path(@plant), class: "rounded-md bg-white py-2 px-3 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
                  <%= form.submit "Update Plant", class: "ml-3 inline-flex justify-center rounded-md bg-green-600 py-2 px-3 text-sm font-semibold text-white shadow-sm hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div> 
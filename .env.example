# Rails Environment
RAILS_ENV=development
RAILS_MASTER_KEY=your_master_key_here

# Database Configuration
SPROUT_SERVER_DATABASE_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_PORT=5432

# Registry Configuration
REGISTRY_USERNAME=your_registry_username
KAMAL_REGISTRY_PASSWORD=your_registry_password

# Application Settings
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
SOLID_QUEUE_IN_PUMA=true

# Development Settings
WEBCONSOLE_PERMISSIONS=127.0.0.0/8,::1

# Optional Settings
# JOB_CONCURRENCY=3
# RAILS_LOG_LEVEL=debug 